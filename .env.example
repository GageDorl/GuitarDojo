# Guitar Dojo production configuration.
# Copy to .env on the server, fill in every value, then: chmod 600 .env
# NEVER commit .env. This file contains no real credentials.

# --- Site ----------------------------------------------------------------------
DOMAIN=dojo.gagedorl.com
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# --- Database (only reachable inside Docker) --------------------------------------
POSTGRES_DB=guitardojo
POSTGRES_USER=guitardojo
# Use hex so it needs no URL escaping:  openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# --- Authentication -----------------------------------------------------------------
# openssl rand -base64 48   (changing it signs everyone out)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-48
# "open" or "closed". Registration also stays closed automatically if email isn't configured.
AUTH_REGISTRATION=open

# --- Email (required for verification and password recovery) ----------------------
EMAIL_FROM="Guitar Dojo <no-reply@gagedorl.com>"
SMTP_HOST=smtp.example.com
# 587 + SMTP_SECURE=false uses STARTTLS (required); 465 + SMTP_SECURE=true uses implicit TLS.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me

# --- Deployment (managed by scripts/deploy.sh) --------------------------------------
APP_VERSION=latest

# --- Backups (scripts/backup.sh) ------------------------------------------------------
# Public key from `age-keygen` (keep the PRIVATE key off this server).
BACKUP_AGE_RECIPIENT=age1replacewithyourpublickey
# rclone remote:path configured with `rclone config`, e.g. b2:guitar-dojo-backups/db
BACKUP_RCLONE_REMOTE=offsite:guitar-dojo-backups/db
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=35
